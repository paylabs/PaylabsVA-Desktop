{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paylabs VA",
  "version": "0.1.4",
  "identifier": "id.co.paylabs.va",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paylabs VA",
        "width": 880,
        "height": 620,
        "minWidth": 880,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJFRUIzQUQ2NzAyRDlEMzMKUldRem5TMXcxanJydmxGalRpQ3MrOVkzZDhkakVoaVN4bThFODJZUEhCK0RiazlYRG1LR29mRmgK",
      "endpoints": [
        "https://github.com/paylabs/PaylabsVA-Desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
